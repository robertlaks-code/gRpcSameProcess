{
  "name": "@grpc-demo/service",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "proto-loader-gen-types --longs=Number --enums=String --defaults --oneofs --grpcLib=@grpc/grpc-js --outDir=src/generated proto/crud.proto",
    "build": "yarn generate && tsc -p tsconfig.json",
    "clean": "rm -rf dist src/generated"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.9",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
